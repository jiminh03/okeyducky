erDiagram
    User {
        int user_id PK "사용자(부모) ID (PK)"
        string email UK "부모 이메일 (UK, 로그인 ID)"
        string password_hash "비밀번호 (해시됨)"
        datetime created_at "가입일"
    }

    Child {
        int child_id PK "아이 ID (PK)"
        int user_id FK "사용자(부모) ID (FK)"
        string name "아이 이름 (호칭용)"
        date birth_date "생년월일"
        string gender "성별"
        string school "학교 (선택)"
    }

    Robot {
        int robot_id PK "로봇 ID (PK)"
        int child_id FK "아이 ID (FK)"
        string serial_number UK "로봇 시리얼 번호 (UK)"
        string status "로봇 연결 상태 (online/offline)"
    }

    DailyReport {
        int report_id PK "일일 리포트 ID (PK)"
        int child_id FK "아이 ID (FK)"
        date date UK "날짜 (UK, YYYY-MM-DD)"
        text daily_summary "일일 대화 요약 (API 3-1)"
        text analysis_summary "AI 분석 요약 (API 3-2)"
    }

    DialogueLog {
        int log_id PK "로그 ID (PK)"
        int report_id FK "DailyReport ID (FK)"
        datetime timestamp "메시지 시간"
        string speaker "발화자 ('child', 'robot_ai', 'robot_parent')"
        text message "메시지 텍스트"
    }

    %% --- 관계 정의 ---
    User ||--|| Child : "has one"
    Child ||--|| Robot : "is assigned one"
    Child ||--o{ DailyReport : "has many"
    DailyReport ||--o{ DialogueLog : "includes many"