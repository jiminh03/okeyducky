graph TD
    %% --- 외부 컴포넌트 (컨텍스트용) ---
    Users["사용자 (웹/로봇)"]
    AI["상용 AI API (STT/LLM/TTS)"]

    subgraph "클라우드 인프라 (Backend)"
        GW[API Gateway / Nginx]
        
        BE["<b>백엔드 서버 (FastAPI)</b><br/>(API / WS / WebRTC)"]
        AI_SVC["<b>AI 처리 서버 (LLM/TTS)</b><br/>(AI API 호출/분석)"]
        
        DB_MYSQL["<b>관계형 DB (MySQL)</b>"]
        R["<b>[Cache & MQ] Redis</b>"]

        %% --- 인프라 내부 연결 (기능 중심) ---
        GW -- "모든 요청 수신 (Gateway)" --> BE
        
        BE <-- "계정/리포트 조회/저장 (CRUD)" --> DB_MYSQL
        BE <-- "세션/AI응답 캐시" --> R
        
        BE -- "실시간 대화/TTS 요청 (API)" --> AI_SVC
        BE -- "리포트 분석 요청 (Publish)" --> R
        
        R -- "리포트 분석 작업 수신 (Subscribe)" --> AI_SVC
        
        AI_SVC -- "분석 리포트 저장 (Write)" --> DB_MYSQL
    end

    %% --- 외부 -> 인프라 ---
    Users -- "HTTPS(API) / WSS(실시간)" --> GW
    Users -- "STT 요청 (음성->텍스트)" --> AI

    %% --- 인프라 -> 외부 ---
    BE -- "실시간 대화 응답 (WS/Push)" --> Users
    AI_SVC -- "LLM(분석/대화) / TTS(음성) 호출" --> AI